{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Resume Authenticator",
  "version": "0.1.0",
  "identifier": "dev.karin.resume-authenticator",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Resume Authenticator",
        "width": 520,
        "height": 760,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": { "active": true, "targets": ["nsis"], "icon": ["icons/icon.ico", "icons/128x128.png", "icons/128x128@2x.png"] },
  "plugins": { "deep-link": { "desktop": { "schemes": ["resume-auth"] } } }
}
