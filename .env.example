# Copy to apps/web/.env.local for Next.js. Scripts use --env-file or exported env.
APP_ORIGIN=https://localhost:3000
# Supabase transaction pooler URI. Server only. Never NEXT_PUBLIC_.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres
SUPABASE_URL=https://PROJECT.supabase.co
# Server-only secret key (sb_secret_...), not the publishable key.
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-key
SUPABASE_STORAGE_BUCKET=resume-photos
